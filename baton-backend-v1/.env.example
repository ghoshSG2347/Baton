BATON_ENV=development
# Optional legacy operator tools only; normal user-owned credentials do not require it.
BATON_ACCESS_KEY=
# Reserved for explicit operator diagnostics; never used as a repository credential.
# Normal repository APIs require the user X-GitHub-Token header.
GITHUB_TOKEN=
# Optional legacy operator provider. Normal users enter their key/model in Repository.
# Never expose operator credentials through VITE_* settings.
GEMINI_API_KEY=
GEMINI_MODEL=
AI_CONTEXT_BYTES=120000
AI_INPUT_BYTES=32000
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=2000
FRONTEND_ORIGINS=http://localhost:5173,https://baton-sigma-six.vercel.app
MAX_FILE_SIZE_BYTES=200000
MAX_TOTAL_CONTEXT_BYTES=2000000
MAX_FILES_PER_ANALYSIS=100

# Analysis-only bounded archives, with bounded tree/content fallback.
GITHUB_ARCHIVE_ANALYSIS=true
MAX_ARCHIVE_BYTES=20000000
MAX_ARCHIVE_EXPANDED_BYTES=40000000
MAX_ARCHIVE_ENTRIES=10000
