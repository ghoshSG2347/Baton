# Baton Frontend Environment Variables
# For local development: http://localhost:8000
# For production deployment: https://baton-shl3.onrender.com
VITE_BATON_API_URL=http://localhost:8000
# Enter a Baton operator access key in workspace settings (memory only).
# Provider keys must never be configured in the frontend.

# Production origin only: no /api or /api/v1 suffix. Provider keys are user-entered
# in tab memory, never VITE_* values. Rebuild after changing this public URL.
